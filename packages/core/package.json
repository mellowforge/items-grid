{
  "name": "@quietfoundry/items-grid-core",
  "version": "0.0.0",
  "description": "Headless engine for card grids that fit the screen: exact page size from the viewport, fixed or measured row height, size presets, client or server paging, live or stable realtime reflow. Zero dependencies.",
  "license": "MIT",
  "author": "Konstantin Penzin",
  "homepage": "https://github.com/Constantine-24/items-grid#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Constantine-24/items-grid.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Constantine-24/items-grid/issues"
  },
  "keywords": [
    "grid",
    "cards",
    "pagination",
    "paging",
    "layout",
    "responsive",
    "css-grid",
    "headless",
    "framework-agnostic",
    "react",
    "angular",
    "vanilla"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
