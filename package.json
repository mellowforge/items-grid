{
  "name": "items-grid-monorepo",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:pages": "node scripts/build-pages.mjs",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm format:check && pnpm build && pnpm lint && pnpm typecheck && pnpm test && pnpm test:hooks && pnpm pack:check && changeset publish",
    "pack:check": "node scripts/pack-check.mjs",
    "test:hooks": "node --test .claude/hooks/block-raw-tooling.test.js"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "prettier": "^3.9.10"
  }
}
