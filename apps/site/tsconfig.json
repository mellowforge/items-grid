{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    /* Source-linked, like the React demo. */
    "paths": {
      "@mellowforge/items-grid-core": ["../../packages/core/src/index.ts"],
      "@mellowforge/items-grid-react": ["../../packages/react/src/index.ts"],
      "demo-shared": ["../demo-shared/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"],
  // Shown on the page as text; it needs the Angular compiler, so it is checked by eye, not tsc.
  "exclude": ["src/examples/angular.example.ts"]
}
